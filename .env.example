# Environment Variables Configuration
# Copy this file to .env to override default parameters

# Local path where the .keras stacked ensemble model is located
MODEL_PATH=models/bug_bite_8class_stacked_model.keras

# Local path where the PyTorch Swin Transformer model is located
SWIN_MODEL_PATH=models/swin_phase2_best.pth

# Local path where the Handcrafted Visual Descriptor model is located
DESCRIPTOR_MODEL_PATH=models/descriptor_classifier.joblib

# GitHub Release direct asset URL for automated stream download
MODEL_URL=https://github.com/nithishv17-dot/ResQ_Ai/releases/download/v1.0.0/bug_bite_8class_stacked_model.keras
